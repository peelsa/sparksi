# Sparksi node announcer, user unit template.
# Render with: sparksi install-unit --print --unit announce --node-id a --controller 100.64.0.1:7501
# That command only prints. It does not write, enable, or start the unit.
#
# The script at %h/.local/bin/sparksi-announce has no addresses of its own.
# SPARKSI_NODE_ID is a [[nodes]] id. SPARKSI_CONTROLLER is host:port of the
# controller's UDP announce listener. SPARKSI_ADVERTISE is that node's
# configured tailscale address from sparksi.toml. A wildcard server is
# published only after one direct GET of that address returns the same
# served id. An empty value leaves the URL unpublished. This process sends
# one datagram; it does not bind a port. Printing this unit does not enable
# or start it. SPARKSI_PROTECT lists the protection presets active on the
# controller when the unit was rendered (empty when none), so a node skips the
# same video service the controller protects.
[Unit]
Description=Sparksi announcer (node stats to the controller over UDP)
After=network-online.target

[Service]
Type=simple
Environment=SPARKSI_NODE_ID=@NODE_ID@
Environment=SPARKSI_CONTROLLER=@CONTROLLER@
Environment=SPARKSI_ADVERTISE=@ADVERTISE@
Environment=SPARKSI_PROTECT=@PROTECT@
ExecStart=/usr/bin/python3 %h/.local/bin/sparksi-announce
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
